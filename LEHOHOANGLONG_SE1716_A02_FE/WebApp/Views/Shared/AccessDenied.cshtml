@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5">
    <i class="bi bi-shield-fill-exclamation text-warning" style="font-size: 5rem;"></i>
    <h1 class="text-warning mt-3">Access Denied</h1>
    <h4 class="mt-3">You don't have permission to access this resource.</h4>
    <p class="text-muted mt-2">
        Please contact your administrator if you believe this is an error.
    </p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-fill"></i> Go to Home
        </a>
        <a asp-controller="Auth" asp-action="Logout" class="btn btn-secondary">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>
</div>
