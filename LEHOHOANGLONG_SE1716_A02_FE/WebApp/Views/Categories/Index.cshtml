@model List<WebApp.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-folder-fill"></i> Categories</h2>
        <p class="text-muted">Manage news categories</p>
    </div>
    <div>
        @if (ViewBag.UserRole == 0)
        {
            <button type="button" class="btn btn-primary" onclick="showCreateModal()">
                <i class="bi bi-plus-circle"></i> Create Category
            </button>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No categories found</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-folder"></i> <strong>@category.CategoryName</strong>
                                </td>
                                <td>@category.CategoryDesciption</td>
                                <td>
                                    @if (ViewBag.UserRole == 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="showEditModal('@category.CategoryId', '@Html.Raw(category.CategoryName)', '@Html.Raw(category.CategoryDesciption)')">
                                            <i class="bi bi-pencil"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                onclick="confirmDelete('@category.CategoryId', '@Html.Raw(category.CategoryName)')">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Create Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="createForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name *</label>
                        <input type="text" class="form-control" id="createName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <textarea class="form-control" id="createDescription" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm">
                <input type="hidden" id="editId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name *</label>
                        <input type="text" class="form-control" id="editName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description *</label>
                        <textarea class="form-control" id="editDescription" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));

        function showCreateModal() {
            document.getElementById('createForm').reset();
            createModal.show();
        }

        function showEditModal(id, name, description) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editDescription').value = description;
            editModal.show();
        }

        function confirmDelete(id, name) {
            if (confirm(`Are you sure you want to delete category: ${name}?\n\nNote: Categories with articles cannot be deleted.`)) {
                deleteCategory(id, name);
            }
        }

        async function deleteCategory(id, name) {
            try {
                const response = await fetch(`/Categories/Delete?id=${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    location.reload();
                } else {
                    const result = await response.json();
                    const errorMsg = result.message || 'Error deleting category';
                    alert(errorMsg);
                }
            } catch (error) {
                console.error('Error deleting category:', error);
                alert('Error deleting category. Please try again.');
            }
        }

        document.getElementById('createForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const data = {
                CategoryName: document.getElementById('createName').value,
                CategoryDesciption: document.getElementById('createDescription').value
            };

            try {
                const response = await fetch('/Categories/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    location.reload();
                } else {
                    const result = await response.json();
                    const errorMsg = result.message || 'Error creating category';
                    alert(errorMsg);
                }
            } catch (error) {
                console.error('Error creating category:', error);
                alert('Error creating category. Please try again.');
            }
        });

        document.getElementById('editForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const id = document.getElementById('editId').value;
            const data = {
                CategoryId: parseInt(id),
                CategoryName: document.getElementById('editName').value,
                CategoryDesciption: document.getElementById('editDescription').value
            };

            try {
                const response = await fetch(`/Categories/Edit/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    location.reload();
                } else {
                    const result = await response.json();
                    const errorMsg = result.message || 'Error editing category';
                    alert(errorMsg);
                }
            } catch (error) {
                console.error('Error editing category:', error);
                alert('Error editing category. Please try again.');
            }
        });
    </script>
}
